# firefox-win-dev / mozconfig.debug  -- default for the edit/build/run loop
#
# Full (non-artifact) build: required when you touch C++/Rust. If a task is
# JS/frontend-only, temporarily add `ac_add_options --enable-artifact-builds`
# and prebuilt binaries replace the compile step entirely.

ac_add_options --enable-debug
ac_add_options --enable-debug-symbols

# sccache caches into $SCCACHE_DIR on the Dev Drive (set by setup.ps1). The binary comes from
# fx-dev.winget (Mozilla.sccache): mach bootstrap does NOT install it, and without it configure
# stops at "Cannot find ccache".
ac_add_options --with-ccache=sccache

# objdir on the Dev Drive, next to the tree, one per configuration.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-debug

# Rebuild from scratch automatically when the build system says it must,
# instead of failing and asking.
mk_add_options AUTOCLOBBER=1
